# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=coresync
DB_USERNAME=root
DB_PASSWORD=root
# Só para o docker compose: senha do root do MySQL no container
DB_ROOT_PASSWORD=root
# Deixe false e use migrations (npm run migration:run). true só em dev descartável.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Porta do servidor (padrão 8080)
PORT=8080

# Frontend (URL do React em desenvolvimento)
FRONTEND_URL=http://localhost:5173

# URL pública da API (usada nos links das fotos locais e no callback do Strava)
API_PUBLIC_URL=http://localhost:8080

# Strava (OAuth por atleta). Crie um app em https://www.strava.com/settings/api
# e use como "Authorization Callback Domain" o host da API (ex.: localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Opcional; padrão: ${API_PUBLIC_URL}/strava/callback
STRAVA_REDIRECT_URI=

# Repositório de fotos dos eventos. Sem AWS_S3_BUCKET, as fotos ficam em ./uploads
# (ou em UPLOAD_DIR) e são servidas pela própria API em /uploads.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: URL pública/CDN do bucket (padrão: https://<bucket>.s3.<region>.amazonaws.com)
AWS_S3_PUBLIC_URL=
UPLOAD_DIR=

# Fuso do servidor: as datas das sessões de treino e das atividades do Strava
# são comparadas pela data local.
TZ=America/Sao_Paulo

# E-mail (fallback das notificações críticas: treino/evento alterado ou cancelado).
# Sem SMTP_HOST, as notificações continuam só no app (WebSocket).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CoreSync <no-reply@seu-dominio.com>
