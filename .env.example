# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=coresync
DB_USERNAME=root
DB_PASSWORD=root
# Só para o docker compose: senha do root do MySQL no container
DB_ROOT_PASSWORD=root
# Deixe false e use migrations (npm run migration:run). true só em dev descartável.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Porta do servidor (padrão 8080)
PORT=8080

# Frontend (URL do React em desenvolvimento)
FRONTEND_URL=http://localhost:5173
