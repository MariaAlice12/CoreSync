# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=coresync
# No Docker, DB_HOST é sempre "db" (o compose sobrescreve). DB_USERNAME não pode
# ser "root" num banco novo: a imagem do MySQL cria esse usuário à parte.
DB_USERNAME=coresync
DB_PASSWORD=troque-esta-senha
# Só para o docker compose: senha do root do MySQL no container
DB_ROOT_PASSWORD=troque-esta-senha-root
# Porta do MySQL no host (só 127.0.0.1), para rodar a API fora do Docker
DB_EXPOSED_PORT=3306
# Deixe false e use migrations (npm run migration:run). true só em dev descartável.
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Primeiro administrador: criado na subida da API se ainda não existir nenhum admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@coresync.local
ADMIN_PASSWORD=troque-esta-senha-admin

# Porta do servidor (padrão 8080)
PORT=8080

# --- Publicação (docker compose) ---
# Endereço fixo do site, se tiver um (named tunnel / domínio). Vazio = quick
# tunnel (URL aleatória *.trycloudflare.com). Ex.: https://coresync.seudominio.com.br
PUBLIC_URL=
# Porta local do site (nginx): http://localhost:8000
WEB_PORT=8000
# Pasta do repositório do front, relativa a este diretório
WEB_DIR=../CoreSyncWeb
# Nº de proxies na frente da API (túnel -> nginx = 2). 0 em dev.
TRUST_PROXY=2
# false esconde a documentação Swagger (/api) com o site público
SWAGGER_ENABLED=true

# Frontend (URL do React em desenvolvimento)
FRONTEND_URL=http://localhost:5173

# URL pública da API (usada nos links das fotos locais e no callback do Strava).
# Dev: http://localhost:8080. No docker compose o padrão é "/backend" (relativo,
# atrás do nginx), ou ${PUBLIC_URL}/backend — use PUBLIC_URL em vez desta.
API_PUBLIC_URL=http://localhost:8080

# Strava (OAuth por atleta). Crie um app em https://www.strava.com/settings/api
# e use como "Authorization Callback Domain" o host da API (ex.: localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Opcional; padrão: ${API_PUBLIC_URL}/strava/callback
STRAVA_REDIRECT_URI=

# Repositório de fotos dos eventos. Sem AWS_S3_BUCKET, as fotos ficam em ./uploads
# (ou em UPLOAD_DIR) e são servidas pela própria API em /uploads.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: URL pública/CDN do bucket (padrão: https://<bucket>.s3.<region>.amazonaws.com)
AWS_S3_PUBLIC_URL=
UPLOAD_DIR=

# Fuso do servidor: as datas das sessões de treino e das atividades do Strava
# são comparadas pela data local.
TZ=America/Sao_Paulo

# E-mail (fallback das notificações críticas: treino/evento alterado ou cancelado).
# Sem SMTP_HOST, as notificações continuam só no app (WebSocket).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoreSync <no-reply@seu-dominio.com>"
